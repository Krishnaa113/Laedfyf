# App
NEXT_PUBLIC_APP_NAME="Leadyfy OS"
# Local:
NEXTAUTH_URL=http://localhost:3000
# Production (Render): https://YOUR-SERVICE.onrender.com
# If this stays localhost in production, login returns 401.

# Auth.js / NextAuth v4 JWT sessions
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=

# MongoDB
# Local: mongodb://127.0.0.1:27017/leadyfy
# Atlas: mongodb+srv://USER:PASSWORD@CLUSTER/leadyfy?retryWrites=true&w=majority
# On Atlas Network Access allow 0.0.0.0/0 so Render can connect.
MONGODB_URI=

# Owner bootstrap. Required for npm run seed. Optional on Render (creates owner on boot).
SEED_OWNER_EMAIL=owner@leadyfy.local
SEED_OWNER_PASSWORD=Leadyfy@123

# When true (default), videos cannot be marked Delivered if the order is Unpaid or Overdue
BLOCK_DELIVERY_IF_UNPAID=true

# Notification channels. In-app is always on. Email/WhatsApp plug into
# lib/notifications/channels.ts without changing trigger call sites.
NOTIFY_EMAIL=false
NOTIFY_WHATSAPP=false
